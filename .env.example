# ==============================================================================
# CodeForge AI Hint Configuration (OpenAI-compatible Chat Completions endpoint)
# ==============================================================================
# Compatible with Groq, Gemini, OpenRouter, Cerebras, Together, OpenAI, etc.
# Leave empty for automatic graceful fallback to handcrafted static hint ladder.
# ==============================================================================

AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_FALLBACK_MODEL=
AI_DAILY_LIMIT=

# ==============================================================================
# CodeForge Multi-Language Judge Execution (Judge0 CE / RapidAPI compatible)
# ==============================================================================
# Defaults to public Judge0 CE (https://ce.judge0.com)
# For RapidAPI: set CODE_API_HOST=judge0-ce.p.rapidapi.com and CODE_API_KEY
# If left empty: client runtimes (Python 3.12, JavaScript, TypeScript) run instantly
# in-browser with zero rate limits. Server runtimes (C++, Java, C) show friendly status.
# ==============================================================================

CODE_API_URL=https://ce.judge0.com
CODE_API_KEY=
CODE_API_HOST=
CODE_API_AUTH_HEADER=
CODE_DAILY_LIMIT=1500
